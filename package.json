{
  "name": "downlee",
  "version": "0.1.0",
  "description": "URL からウェブの動画を最高画質のままダウンロードする Windows デスクトップアプリ",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/sync-fonts.mjs && vite",
    "build": "node scripts/sync-fonts.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"electron/*.test.cjs\"",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "node scripts/clean-release.mjs && npm run build && node scripts/fetch-tools.mjs && electron-builder --win nsis",
    "fetch-tools": "node scripts/fetch-tools.mjs",
    "sync-fonts": "node scripts/sync-fonts.mjs"
  },
  "build": {
    "appId": "com.downlee.app",
    "productName": "Downlee",
    "directories": {
      "app": ".",
      "output": "release"
    },
    "files": [
      "electron/**",
      "!electron/*.test.cjs",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "bin",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Downlee",
      "uninstallDisplayName": "Downlee",
      "artifactName": "Downlee-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^6.4.5"
  }
}
